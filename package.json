{
  "name": "herramientas-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal PDF con Node.js y SQLite para VPS, con adaptador Cloudflare opcional",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "npm run build && node src/node/server.js",
    "check": "node --check src/index.js",
    "db:init:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:services": "node tests/browser-services.mjs",
    "start": "node src/node/server.js",
    "dev:cloudflare": "npm run build && wrangler dev",
    "admin:owner": "node scripts/owner.mjs",
    "backup:create": "node scripts/backup.mjs",
    "backup:restore": "node scripts/backup.mjs restore",
    "test:vps": "node tests/browser-vps.mjs",
    "test:docker": "python3 tests/docker-vps.py",
    "package:release": "npm run build && node scripts/package.mjs",
    "test:advertising": "node tests/browser-advertising.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.0-beta",
    "playwright-core": "1.57.0",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "proper-lockfile": "4.1.2"
  }
}
