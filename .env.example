# Copiar a .env y completar con datos reales del dominio y responsable.
DOMAIN=pdfalinstante.com
ACME_EMAIL=
INDEXING_ENABLED=false
# No poner contraseñas aquí: el propietario se crea por consola.
# Activar solo tras comprobar códigos reales y política del proveedor.
ADVERTISING_ENABLED=false
# Hostnames HTTPS exactos, separados por comas. Sin comodines ni rutas.
AD_PROVIDER_HOSTS=

# Para probar banners: crear DNS A ads.DOMAIN hacia el VPS.
# Compose configura automáticamente AD_ORIGIN=https://ads.DOMAIN.
